yt=y(27); str='DAY'; text(t0+1,yt,[str],'FontSize',10);
for i=1:2:(days*2); 
str='NIGHT'; text(tf(i)+1,yt,[str],'FontSize',10);
i=i+1; str='DAY'; text(tf(i)+1,yt,[str],'FontSize',10);
end; end;

