%/////////////////////////////////////////////////////////////////////////////////////    runconcs_het.m
% ***runconcs_het calls concs_het***                                                   last run: 5/26/26
% Function:   model cl production and loss from heterogeneous reactions
% Procedure:  set temp, pressure, and initial concs
% Can step down H2O and T with time; * Not redefining M values as change T, which introduces ~ 5% max error (~10K/200K)

clear all;

global T P M SA WTR SZA Yn2o5 count opt
count=0; conv=760/1013.25;

% SET THESE VALUES
T=210;                      % temperature
P=68;                       % run at 100 90 83 or 68 mbar (MLS plevels - 121 100 83 68 46,  i.e., ~15 16.5 17.5 19 21 km)  
M=9.65e18*P/T*conv;         % molec/cm3 (mbar to torr conversion in M calc)
Yn2o5=0.1;                  % gamma for n2o5+h2o rxn: all studies ~0.05-0.2 (no T-dep included)
SA=2;                       % aerosol surface area (typically 1-5 um2/cm3)
WTR=5;                     % water vapor in ppm
opt=1;                      % 0 to run O1D chem new way w/ full rxns & reduced AbsTol; 1 to run old way with workaround as in Science paper  
stpdwn=0;                   % step down water concentration as function of time; 1=on, 0=off; not currently coded for all WTR values
stpdwnT=0;                  % for Temperature, step down temperature as function of time; 1=on, 0=off
td=14;                      % length of day in hours
tn=10;                      % length of night in hours, td+tn=24
days=5;                     % number of days to run out beyond the starting daytime period that initiates model
num=31;                      % figure #, so don't have to scroll down to change

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% INITIAL VALUES IN PPT			  		   CONVERT UNITS TO MOLEC/CM3
if P==100;                                  % ~16.5km
ClO_i 	= 10;                               ClO_i = ClO_i.*1e-12.*M;            % estimate 10 ppt
ClONO2_i= 42;                               ClONO2_i = ClONO2_i.*1e-12.*M;      % 15% Cly (346) - ClO = 42 ppt           42
HCl_i 	= 294;								HCl_i = HCl_i.*1e-12.*M;            % MLS mean 294 ppt (1-sig = 238)         294
NO_i 	= 300;                              NO_i = NO_i.*1e-12.*M;              % in situ 300 ppt
NO2_i 	= 300;								NO2_i = NO2_i.*1e-12.*M;            % in situ 300 ppt
O3_i 	= 0.43e6;                    		O3_i = O3_i.*1e-12.*M;              % MLS mean 434 ppb                       0.43
HNO3_i  = 1100;      						HNO3_i = HNO3_i.*1e-12.*M;          % MLS mean 1100 ppt
BrO_i   = 2;                                BrO_i = BrO_i.*1e-12.*M;            % estimate 2 ppt
end;

if P==90;                                  % ~17km
ClO_i 	= 10;                               ClO_i = ClO_i.*1e-12.*M;            % estimate 10 ppt
ClONO2_i= 70;                               ClONO2_i = ClONO2_i.*1e-12.*M;      % 15% Cly (530) - ClO = 70 ppt          SEAC4RS: 100 MLS; 165 ACE
HCl_i 	= 450;								HCl_i = HCl_i.*1e-12.*M;            % MLS interp 450 ppt                     SEAC4RS: 500 MLS; 732 ACE  
NO_i 	= 350;                              NO_i = NO_i.*1e-12.*M;              % in situ 350 ppt
NO2_i 	= 350;								NO2_i = NO2_i.*1e-12.*M;            % in situ 350 ppt
O3_i 	= 0.65e6;                    		O3_i = O3_i.*1e-12.*M;              % MLS interp 650 ppb                     0.5 in situ SEAC4RS
HNO3_i  = 1840;      						HNO3_i = HNO3_i.*1e-12.*M;          % MLS interp 1840 ppt 
BrO_i   = 3;                                BrO_i = BrO_i.*1e-12.*M;            % estimate 3 ppt
end;

if P==83;                                   % ~17.5km
ClO_i 	= 10;                               ClO_i = ClO_i.*1e-12.*M;            % estimate 10 ppt
ClONO2_i= 87;                               ClONO2_i = ClONO2_i.*1e-12.*M;      % 15% Cly (648) - ClO = 87 ppt            87
HCl_i 	= 551;								HCl_i = HCl_i.*1e-12.*M;            % MLS interp 551 ppt                      551
NO_i 	= 400;                              NO_i = NO_i.*1e-12.*M;              % in situ 400 ppt
NO2_i 	= 400;								NO2_i = NO2_i.*1e-12.*M;            % in situ 400 ppt
O3_i 	= 0.79e6;                    		O3_i = O3_i.*1e-12.*M;              % MLS mean 794 ppb                        0.79
HNO3_i  = 2360;      						HNO3_i = HNO3_i.*1e-12.*M;          % MLS interp 2360 ppt
BrO_i   = 3;                                BrO_i = BrO_i.*1e-12.*M;            % estimate 3 ppt
end;

if P==68;                                   % ~19km
ClO_i 	= 10;                               ClO_i = ClO_i.*1e-12.*M;            % estimate 10 ppt
ClONO2_i= 127;                              ClONO2_i = ClONO2_i.*1e-12.*M;      % 15% Cly (914) - ClO = 127 ppt
HCl_i 	= 777.*1E-9;								HCl_i = HCl_i.*1e-12.*M;            % MLS mean 777 ppt
NO_i 	= 450;                              NO_i = NO_i.*1e-12.*M;              % in situ 450 ppt                       %FK is messing with this
NO2_i 	= 450;								NO2_i = NO2_i.*1e-12.*M;            % in situ 450 ppt                           
O3_i 	= 1.18e6;                    		O3_i = O3_i.*1e-12.*M;              % MLS mean 1183 ppb
HNO3_i  = 3470;      						HNO3_i = HNO3_i.*1e-12.*M;          % MLS mean 3470 ppt
BrO_i   = 3.*0;                                BrO_i = BrO_i.*1e-12.*M;            % estimate 3 ppt
end;

% MLS Cly=1170ppt & HCl/O3=0.60; in situ Cly=1500ppt; extreme Cly=1750ppt
if P==60;                                   % ~19.5km                                                               % MLS      in situ      extreme
ClO_i 	= 10;                               ClO_i = ClO_i.*1e-12.*M;            % estimate 10 ppt                      10       10           10 
ClONO2_i= 165;                              ClONO2_i = ClONO2_i.*1e-12.*M;      % 15% Cly (1170) - ClO = 165 ppt      165      215          252
HCl_i 	= 997;								HCl_i = HCl_i.*1e-12.*M;            % MLS mean 997 ppt                    997      1275         1488
NO_i 	= 500;                              NO_i = NO_i.*1e-12.*M;              % in situ 500 ppt
NO2_i 	= 500;								NO2_i = NO2_i.*1e-12.*M;            % in situ 500 ppt
O3_i 	= 1.67e6;                    		O3_i = O3_i.*1e-12.*M;              % MLS mean 1670 ppb                   1670     2130         2480
HNO3_i  = 4550;      						HNO3_i = HNO3_i.*1e-12.*M;          % MLS mean 4550 ppt
BrO_i   = 6;                                BrO_i = BrO_i.*1e-12.*M;            % increase BrO at this alt (Pundt 2002) 6 ppt
end;

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Leave other variables unchanged for all starting P levels
  % OH and HO2 have fairly small gradient 16.5-19km and starting concs don't matter - chemistry sets concs
Cl_i    = 0;								Cl_i = Cl_i.*1e-12.*M;
ClOOCl_i= 0;								ClOOCl_i = ClOOCl_i.*1e-12.*M;
Cl2_i 	= 0;								Cl2_i = Cl2_i.*1e-12.*M;
O_i 	= 0;								O_i = O_i.*1e-12.*M;
O2_i 	= 0.21.*M;
CH3_i 	= 0;								CH3_i = CH3_i.*1e-12.*M;
CH4_i 	= 1.6e6;							CH4_i = CH4_i.*1e-12.*M;
H2O_i 	= WTR.*1e6;                         H2O_i = H2O_i.*1e-12.*M;    % WTR defined above to change more easily FK changed
HOCl_i 	= 0;                                HOCl_i = HOCl_i.*1e-12.*M;
N2O5_i 	= 20;                               N2O5_i = N2O5_i.*1e-12.*M;  
NO3_i 	= 0;                                NO3_i = NO3_i.*1e-12.*M;    % est ~0 during day due to rapid photolysis
OH_i    = 0.5;                              OH_i = OH_i.*1e-12.*M;      % originally pinned OH to 0.5 ppt during day and 0 ppt at night
HO2_i   = 3;                                HO2_i = HO2_i.*1e-12.*M;    % est 3 ppt at 17 km
O1D_i   = 0;                                O1D_i = O1D_i.*1e-12.*M; 
HONO_i  = 0;                                HONO_i = HONO_i.*1e-12.*M; 
HNO4_i  = 0;                                HNO4_i = HNO4_i.*1e-12.*M; 
OClO_i  = 0;                                OClO_i = OClO_i.*1e-12.*M;
Br_i    = 0;                                Br_i = Br_i.*1e-12.*M;
BrONO2_i= 0;                                BrONO2_i = BrONO2_i.*1e-12.*M;
BrCl_i  = 0;                                BrCl_i = BrCl_i.*1e-12.*M;
HBr_i   = 0;                                HBr_i = HBr_i.*1e-12.*M;
HOBr_i  = 0;                                HOBr_i = HOBr_i.*1e-12.*M;
HNO3aq_i= 0;                                HNO3aq_i = HNO3aq_i.*1e-12.*M;
C2H6_i 	= 200;                              C2H6_i = C2H6_i.*1e-12.*M;
SO2_i   = 2.4e9;                       SO2_i = SO2_i.*1e-12.*M;
H2O2_i  = 0;                                H2O2_i = H2O2_i.*1e-12.*M;

% FK added xppm of SO2ear and H2O2


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% STEPDOWN for water and/or temperature - max 20 days
% first define WTRp with no step down, so it is possible to run T stepdown without stepping down water
WTRp=[WTR 0 WTR 0 WTR 0 WTR 0 WTR 0 WTR 0 WTR 0 WTR 0 WTR 0 WTR 0 WTR 0 WTR 0 WTR 0 WTR 0 WTR 0 WTR 0 WTR 0 WTR 0 WTR 0 WTR];

% define step down in water concs - 1st daytime period runs at init WTR before this starts; every other value is read here, max 20 days
if stpdwn==1;
  if WTR==12; WTRp=[12 0 12 0 12 0 5 0 5 0 5 0 5 0 5 0 5 0 5 0 5 0 5 0 5 0 5 0 5 0 5 0 5 0 5 0 5 0 5];  end;
  if WTR==10; WTRp=[10 0 5 0 5 0 5 0 5 0 5 0 5 0 5 0 5 0 5 0 5 0 5 0 5 0 5 0 5 0 5 0 5 0 5 0 5 0 5];  end;
  if WTR==13; WTRp=[13 0 12 0 11 0 10 0 9 0 8 0 7 0 6 0 5 0 5 0 5 0 5 0 5 0 5 0 5 0 5 0 5 0 5 0 5 0 5]; end;
  if WTR==18; WTRp=[18 0 12 0 12 0 8 0 8 0 5 0 5 0 5 0 5 0 5 0 5 0 5 0 5 0 5 0 5 0 5 0 5 0 5 0 5 0 5];  end;
  if WTR==20; WTRp=[20 0 19 0 18 0 17 0 16 0 15 0 14 0 13 0 12 0 11 0 10 0 9 0 8 0 7 0 6 0 5 0 5 0 5 0 5 0 5];  end;
end;

% define 0.05 K/day per ppm H2O step down in T - 1st daytime period runs at init T before this starts; every other value is read here, max 20 days
% two for loop options: 1) step down using all H2O; 2) subtract bckgrnd 5ppm first b/c ref temps used for real atm already include cooling from this
if stpdwnT==1;
  Tp=zeros(1,40); Tp(1)=T;  
  %for i=3:2:39; Tp(i)=Tp(i-2)-0.05.*WTRp(i-2); end;  % for given WTRp defined above, this code steps down Temp 0.05 K/day per ppm H2O
  for i=3:2:39; Tp(i)=Tp(i-2)-0.05.*(WTRp(i-2)-5); end;  % for given WTRp defined above, subtract 5ppm and step down Temp 0.05 K/day per ppm H2O
%Tp=[T 0 T-0.5 0 T-1 0 T-1.5 0 T-2 0 T-2.5 0 T-3 0 T-3.5 0 T-4 0 T-4.5 0 T-5 0 T-5.5 0 T-6 0 T-6.5 0 T-7 0 T-7.5 0 T-8 0 T-8.5 0 T-9 0 T-9.5 0];%10ppm
%Tp=[T 0 T-1 0 T-2 0 T-3 0 T-4 0 T-5 0 T-6 0 T-7 0 T-8 0 T-9 0 T-10 0 T-10 0 T-10 0 T-10 0 T-10 0 T-10 0 T-10 0 T-10 0 T-10 0 T-10 0];         %20ppm          
%te=10; Tp=[T+te 0 T+te 0 T+te 0 T+te 0 T+te 0 T+te 0 T+te 0 T+te 0 T+te 0 T+te 0 T+te 0 T+te 0 T+te 0 T+te 0 T+te 0 T+te 0 T+te 0 T+te 0 T+te 0 T+te 0]; %add T
end;

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Adjust absolute error tolerance so ode won't fail to meet integration tolerances for O3 photol to O1D and rapid quenching to O (r20b, r40, r41) 
% options applies to every time call odes below; matlab default RelTol=1e-3 & AbsTol=1e-6; only change AbsTol to 1e-3 for O and O1D.
% *Matlab still crashes with this adjustment but less often. Can set tol=1e-2 esp if days>=4, but regardless at times must use workaround.
if opt==0; tol=1e-3; else; tol=1e-6; end;
options = odeset('RelTol',1e-3,'AbsTol',[1e-6 1e-6 1e-6 1e-6 1e-6 1e-6 1e-6 1e-6 ...
    tol 1e-6 1e-6 1e-6 1e-6 1e-6 1e-6 1e-6 1e-6 1e-6 1e-6 1e-6 ...
    tol 1e-6 1e-6 1e-6 1e-6 1e-6 1e-6 1e-6 1e-6 1e-6 1e-6 1e-6 1e-6 1e-6]);                      % FK added two value 1e-6 at end
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% CALL ODE 1 - run first daylight period to set up, then run 24-periods for nighttime-daytime through for loop
t0=0;
tf=td.*3600;       % convert ending time for this daylight period to seconds
SZA=1;             % solar zenith angle: 1=day (45 deg), 0=night

[t,x]=ode15s('concs_het',[t0 tf], [Cl_i; ClO_i; ClOOCl_i; ClONO2_i; HCl_i; Cl2_i; NO_i; NO2_i; ...
    O_i; O2_i; O3_i; CH3_i; CH4_i; HNO3_i; H2O_i; HOCl_i; N2O5_i; NO3_i; OH_i; HO2_i; ...
    O1D_i; HONO_i; HNO4_i; OClO_i; Br_i; BrO_i; BrONO2_i; BrCl_i; HBr_i; HOBr_i; HNO3aq_i; C2H6_i; SO2_i; H2O2_i;],options);

% name variables and transpose for concatenate below
Cl=x(:,1)';		   ClO=x(:,2)';		  ClOOCl=x(:,3)';		 ClONO2=x(:,4)';		HCl=x(:,5)';
Cl2=x(:,6)';	   NO=x(:,7)';        NO2=x(:,8)';           O=x(:,9)';             O2=x(:,10)';
O3=x(:,11)';       CH3=x(:,12)';      CH4=x(:,13)';          HNO3=x(:,14)';         H2O=x(:,15)';	
HOCl=x(:,16)';     N2O5=x(:,17)';     NO3=x(:,18)';          OH=x(:,19)';           HO2=x(:,20)';
O1D=x(:,21)';      HONO=x(:,22)';     HNO4=x(:,23)';         OClO=x(:,24)';         Br=x(:,25)';
BrO=x(:,26)';      BrONO2=x(:,27)';   BrCl=x(:,28)';         HBr=x(:,29)';          HOBr=x(:,30)';
HNO3aq=x(:,31)';   C2H6=x(:,32)';     SO2=x(:,33)';          H2O2=x(:,34)';         time=t';                         %FK added SO2 and H2O2


for i=2:2:(days*2);         % for loop is run once for each 24-hour period
if stpdwn==1; WTR=WTRp(i-1); H2O_p=WTR.*1e6; H2O_p=H2O_p.*1e-12.*M; end;     % define H2O for step down and convert to molec/cm3
if stpdwnT==1; T=Tp(i-1); end;                                               % define Temp for step down

% CALL NIGHTTIME ODE
tf(i)=tf(i-1)+tn.*3600;     % convert ending time for this nighttime period to seconds
SZA=0;                      % solar zenith angle, 0=nighttime

j=find(time==tf(i-1));                  % ending concentrations above are used as starting concentrations
if stpdwn==0; H2O_p=H2O(j); end;        % if not stepping down, find H2O conc same as other species 
[t,x]=ode15s('concs_het',[tf(i-1) tf(i)], [Cl(j); ClO(j); ClOOCl(j); ClONO2(j); HCl(j); Cl2(j); NO(j); NO2(j); ...
    O(j); O2(j); O3(j); CH3(j); CH4(j); HNO3(j); H2O_p; HOCl(j); N2O5(j); NO3(j); OH(j); HO2(j); ...
    O1D(j); HONO(j); HNO4(j); OClO(j); Br(j); BrO(j); BrONO2(j); BrCl(j); HBr(j); HOBr(j); HNO3aq(j); C2H6(j); SO2(j); H2O2(j);],options);  %FK added SO2 and H2O2

% concatenate 
Cl=[Cl x(:,1)'];         ClO=[ClO x(:,2)'];        ClOOCl=[ClOOCl x(:,3)'];       ClONO2=[ClONO2 x(:,4)'];      
HCl=[HCl x(:,5)'];       Cl2=[Cl2 x(:,6)'];        NO=[NO x(:,7)'];               NO2=[NO2 x(:,8)'];      
O=[O x(:,9)'];           O2=[O2 x(:,10)'];         O3=[O3 x(:,11)'];              CH3=[CH3 x(:,12)'];
CH4=[CH4 x(:,13)'];      HNO3=[HNO3 x(:,14)'];     H2O=[H2O x(:,15)'];            HOCl=[HOCl x(:,16)'];
N2O5=[N2O5 x(:,17)'];    NO3=[NO3 x(:,18)'];       OH=[OH x(:,19)'];              HO2=[HO2 x(:,20)'];      
O1D=[O1D x(:,21)'];      HONO=[HONO x(:,22)'];     HNO4=[HNO4 x(:,23)'];          OClO=[OClO x(:,24)'];
Br=[Br x(:,25)'];        BrO=[BrO x(:,26)'];       BrONO2=[BrONO2 x(:,27)'];      BrCl=[BrCl x(:,28)']; 
HBr=[HBr x(:,29)'];      HOBr=[HOBr x(:,30)'];     HNO3aq=[HNO3aq x(:,31)'];      C2H6=[C2H6 x(:,32)'];
SO2=[SO2 x(:,33)'];      H2O2=[H2O2 x(:,34)'];     time=[time t'];                                                                              %FK added SO2 and H2O2


% CALL DAYTIME ODE
i=i+1;                      % this is why step by 2 in for loop
tf(i)=tf(i-1)+td.*3600;     % convert ending time for this daytime period to seconds
SZA=1;                      % solar zenith angle, 1=daytime

j=find(time==tf(i-1));                  % ending concentrations above are used as starting concentrations
if stpdwn==0; H2O_p=H2O(j); end;        % if not stepping down, find H2O conc same as other species
[t,x]=ode15s('concs_het',[tf(i-1) tf(i)], [Cl(j); ClO(j); ClOOCl(j); ClONO2(j); HCl(j); Cl2(j); NO(j); NO2(j); ...
    O(j); O2(j); O3(j); CH3(j); CH4(j); HNO3(j); H2O_p; HOCl(j); N2O5(j); NO3(j); OH(j); HO2(j); ...
    O1D(j); HONO(j); HNO4(j); OClO(j); Br(j); BrO(j); BrONO2(j); BrCl(j); HBr(j); HOBr(j); HNO3aq(j); C2H6(j); SO2(j); H2O2(j); ...
    ],options);            %FK added SO2

% concatenate 
Cl=[Cl x(:,1)'];         ClO=[ClO x(:,2)'];        ClOOCl=[ClOOCl x(:,3)'];       ClONO2=[ClONO2 x(:,4)'];      
HCl=[HCl x(:,5)'];       Cl2=[Cl2 x(:,6)'];        NO=[NO x(:,7)'];               NO2=[NO2 x(:,8)'];      
O=[O x(:,9)'];           O2=[O2 x(:,10)'];         O3=[O3 x(:,11)'];              CH3=[CH3 x(:,12)'];
CH4=[CH4 x(:,13)'];      HNO3=[HNO3 x(:,14)'];     H2O=[H2O x(:,15)'];            HOCl=[HOCl x(:,16)'];
N2O5=[N2O5 x(:,17)'];    NO3=[NO3 x(:,18)'];       OH=[OH x(:,19)'];              HO2=[HO2 x(:,20)'];      
O1D=[O1D x(:,21)'];      HONO=[HONO x(:,22)'];     HNO4=[HNO4 x(:,23)'];          OClO=[OClO x(:,24)'];
Br=[Br x(:,25)'];        BrO=[BrO x(:,26)'];       BrONO2=[BrONO2 x(:,27)'];      BrCl=[BrCl x(:,28)']; 
HBr=[HBr x(:,29)'];      HOBr=[HOBr x(:,30)'];     HNO3aq=[HNO3aq x(:,31)'];      C2H6=[C2H6 x(:,32)'];
SO2=[SO2 x(:,33)'];      H2O2=[H2O2 x(:,34)'];     time=[time t'];                                                                            %FK added SO2

end;

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% CONVERT UNITS BACK TO PPT  
cl=Cl./M.*1e12;                         clo=ClO./M.*1e12;                   cloocl=ClOOCl./M.*1e12; 
clono2=ClONO2./M.*1e12;                 hcl=HCl./M.*1e12;                   cl2=Cl2./M.*1e12; 
no=NO./M.*1e12;                         no2=NO2./M.*1e12;                   o=O./M.*1e12; 
o2=O2./M.*1e12;                         o3=O3./M.*1e12;                     ch3=CH3./M.*1e12; 
ch4=CH4./M.*1e12;                       hno3=HNO3./M.*1e12;                 h2o=H2O./M.*1e12; 
hocl=HOCl./M.*1e12;                     n2o5=N2O5./M.*1e12;                 no3=NO3./M.*1e12; 
oh=OH./M.*1e12;                         ho2=HO2./M.*1e12;                   o1d=O1D./M.*1e12;
hono=HONO./M.*1e12;                     hno4=HNO4./M.*1e12;                 oclo=OClO./M.*1e12;
br=Br./M.*1e12;                         bro=BrO./M.*1e12;                   brono2=BrONO2./M.*1e12;
brcl=BrCl./M.*1e12;                     hbr=HBr./M.*1e12;                   hobr=HOBr./M.*1e12;
hno3aq=HNO3aq./M.*1e12;                 c2h6=C2H6./M.*1e12;                 so2=SO2./M.*1e12;
h2o2=H2O2./M.*1e12;                                                                                 %FK added SO2

t=time./3600; tf=tf./3600;         % convert time from seconds to hours
TOT=cl+clo+2*cloocl+clono2+hcl+2*cl2+hocl+oclo+brcl;  % total inorganic chlorine

%{
% FIGURE 1  FIGURE 1  FIGURE 1  FIGURE 1  FIGURE 1  FIGURE 1  FIGURE 1  FIGURE 1  FIGURE 1
figure(num); clf; 
plot(t,hcl,'r',t,clono2,'g',t,no2,'m',t,TOT,'k',t,cloocl,'c',t,cl2,'y',t,no,'k',t,clo,'b','LineWidth',2); 
%plot(t,hcl,'r',t,clono2,'g',t,no2,'m',t,cloocl,'c',t,cl2,'y',t,no,'k',t,clo,'b','LineWidth',2);  % for paper
%plot(t,hcl,'r',t,clono2,'g',t,no2,'m',t,TOT,'k',t,no,'k',t,clo,'b','LineWidth',2); 
%plot(t,hcl,'r',t,clono2,'g',t,no2,'m',t,no,'k',t,clo,'b','LineWidth',2);  % for paper
xlabel(['Time (hr)'],'FontSize',12); 
ylabel(['Mixing Ratio (pptv)'],'FontSize',12);

j=find(t==max(t));
text(t(j),clo(j),[' ClO'],'FontSize',10);
text(t(j),hcl(j),[' HCl'],'FontSize',10);
text(t(j),clono2(j),[' ClONO_2'],'FontSize',10);
text(t(j),no2(j),[' NO_2'],'FontSize',10);
text(t(j),TOT(j),[' Cl_y'],'FontSize',10);
text(t(j),cloocl(j),[' ClOOCl'],'FontSize',10);
text(t(j),cl2(j),[' Cl_2'],'FontSize',10);
