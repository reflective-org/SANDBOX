# Plume Studio environment. Copy to `.env` and edit; `.env` is never committed.
#
# Secrets live here and ONLY here (studio/CLAUDE.md). Nothing in this file is read yet -- Phase 0
# task 0.1 is the skeleton -- but the names are the contract the runner, the API and the data layer
# are built against, so they are fixed now rather than invented per module later.
#
# There is no in-app user model and no secret for one: authentication is delegated to a reverse
# proxy (ASSUMPTION-3, BLOCKING-2 still open).

# --- storage (ADR-004, ADR-007) -----------------------------------------------------------------
# SQLite in Phase 0; a Postgres URL substitutes without code changes, which is the whole point of
# putting Alembic in from the first migration. Path is relative to the repository root.
STUDIO_DATABASE_URL=sqlite:///./var/studio/studio.db

# Run artefacts -- state.npz, RunSummary, captured stdout/stderr -- behind the storage interface.
# A directory today; MinIO or S3 substitutes without touching callers (ADR-004).
STUDIO_ARTIFACT_ROOT=./var/studio/artifacts

# --- execution (ADR-008, ASSUMPTION-4) ----------------------------------------------------------
# Concurrent local subprocesses. 4 is the assumed default: each run is single-threaded by the
# thread-pinning environment (launch_parallel.py:26-30), so this is a core count, not a guess about
# memory. Revisit per machine.
STUDIO_MAX_WORKERS=4

# Per-run wall-clock cap in seconds. A run stopped by it is TERMINATED_ON_LIMIT and is never
# presented as converged. 3600 s covers the measured 3-5 min for a 10-day/80-bin case and the
# 30-40 min for 60 days (BLOCKING-4), with headroom.
STUDIO_MAX_WALL_TIME_S=3600

# --- climatology (Phase 1, BLOCKING-5) ----------------------------------------------------------
# Copernicus CDS credentials for ERA5 retrieval. Used only by the preprocessing pipeline in
# data/pipelines/, never by the API at request time; raw gridded fields are never committed.
# CDSAPI_URL=https://cds.climate.copernicus.eu/api
# CDSAPI_KEY=
